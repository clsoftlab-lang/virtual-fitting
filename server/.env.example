#
# 이 파일을 `.env` 로 복사한 뒤 실제 키를 채우세요:  cp .env.example .env
# ⚠️ `.env` 는 절대 커밋하지 마세요(.gitignore 에 제외됨). 키는 서버 전용입니다.

# Anthropic API 키 (형식 예: sk-ant-... — 실제 키를 여기에)
ANTHROPIC_API_KEY=

# (선택) 모델. 비용 우선 기본값 claude-haiku-4-5.
# 품질을 높이려면 claude-sonnet-5 또는 claude-opus-5 로.
AI_MODEL=claude-haiku-4-5

# (선택) 비-Haiku 모델의 사고 강도(effort). 기본 low. (Haiku 는 무시)
AI_EFFORT=low

# (선택) 비용 가드레일. IP당 분당 요청 수(기본 20), 월 토큰 예산(기본 2000000).
# 초과 시 429 {"fallback":true} → 프론트가 mock 으로 자동 폴백.
AI_RATE_LIMIT_PER_MIN=20
AI_MONTHLY_TOKEN_CAP=2000000

# (선택) 프록시 포트. 기본 8787.
PORT=8787

# (선택) 허용 CORS 오리진. 기본 "*". 운영에서는 프론트 도메인으로 좁히세요.
CORS_ORIGIN=*
