#
# 이 파일을 `.env` 로 복사한 뒤 실제 키를 채우세요:  cp .env.example .env
# ⚠️ `.env` 는 절대 커밋하지 마세요(.gitignore 에 제외됨). 키는 서버 전용입니다.

# Anthropic API 키 (형식 예: sk-ant-... — 실제 키를 여기에)
ANTHROPIC_API_KEY=

# (선택) 프록시 포트. 기본 8787.
PORT=8787

# (선택) 허용 CORS 오리진. 기본 "*". 운영에서는 프론트 도메인으로 좁히세요.
CORS_ORIGIN=*
